# Local-only operation is the default.
VOXBENCH_AUTH_ENABLED=false
VOXBENCH_REMOTE_ACCESS=false
VOXBENCH_PORT=7860

# Inference service used by the application. The shared launcher configures
# these automatically; set them manually for app-only/remote deployments.
VOXBENCH_INFERENCE_MODE=service
VOXBENCH_MODEL_URL=http://127.0.0.1:7861
VOXBENCH_MODEL_API_KEY=
VOXBENCH_INFERENCE_TIMEOUT=600

# Standalone model-service listener. Use 0.0.0.0 only on a protected network.
VOXBENCH_MODEL_HOST=127.0.0.1
VOXBENCH_MODEL_PORT=7861

# Generic hosted-provider adapter (not exposed in the current Gradio UI).
VOXBENCH_PROVIDER_URL=
VOXBENCH_PROVIDER_API_KEY=
VOXBENCH_PROVIDER_MODEL=

# Required when authentication is enabled.
VOXBENCH_USERNAME=voxbench
VOXBENCH_PASSWORD_HASH=
VOXBENCH_SESSION_SECRET=

# Set true only when VoxBench is served through HTTPS.
VOXBENCH_COOKIE_SECURE=false
